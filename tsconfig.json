{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    
    "paths": {
      "@/*": [
        "./*"
      ],
      "components/*": [
        "./components/*"
      ],
    },
    "module": "esnext",
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
